# Database (Railway's MySQL service can supply these values)
DB_URL='jdbc:mysql://localhost:3306/medical_aid_tracker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
DB_USERNAME=medical_aid
DB_PASSWORD=change-me

# Google Cloud OAuth 2.0 web client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend and browser security
APP_FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=8h

# Runtime
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_TIME_ZONE=Asia/Kolkata
APP_LOG_LEVEL=INFO
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
