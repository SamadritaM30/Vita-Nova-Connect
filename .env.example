# Shared local-development values. Copy service-specific examples instead of
# committing a real .env file.
MYSQL_DATABASE=medical_aid_tracker
MYSQL_USER=medical_aid
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# OAuth credentials are created in Google Cloud Console.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

